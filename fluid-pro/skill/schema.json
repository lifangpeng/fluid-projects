{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "meta": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": []
    },
    "fluid": {
      "type": "object",
      "properties": {
        "density_kg_m3": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": []
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "source",
              "pump",
              "junction",
              "load"
            ]
          },
          "pressure_pa": {
            "type": "number"
          },
          "min_flow_m3s": {
            "type": "number",
            "minimum": 0
          },
          "min_pressure_pa": {
            "type": "number"
          },
          "function": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id"
        ]
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "resistance": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "model": {
            "enum": [
              "linear",
              "quadratic"
            ]
          },
          "diameter_m": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "enabled": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "from",
          "to",
          "resistance"
        ]
      }
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "target_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "states": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "default": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "target_ids",
          "states",
          "default"
        ]
      }
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "extends": {
            "type": "string",
            "minLength": 1
          },
          "set": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id"
        ]
      }
    }
  },
  "required": [
    "nodes",
    "edges"
  ]
}
